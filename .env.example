# Decisions: local Laya on Apple Silicon (default, free, offline) or the hosted TypeSafe Jev policy.
DECISION_MODEL=laya
LAYA_MODEL=aac6fef/laya-typed-decisions-mlx
# DECISION_MODEL=typesafe
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Text model: initial planning plus up to two repair stages (up to three validated responses per stage),
# plus TYPE_TEXT values in the TypeSafe mode. Any OpenAI-compatible endpoint; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# A locally hosted model can avoid remote inference. A localhost proxy may still use paid cloud models.
# Credentials are optional for unauthenticated localhost services, e.g. Ollama:
# TEXT_MODEL_BASE_URL=http://localhost:11434/v1
# TEXT_MODEL=gemma4:latest
